generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Channel {
  PHONE
  EMAIL
  SMS
}

enum Department {
  KADRY
  ADMINISTRACJA
  KONTAKT
  HR
  HR_ENG // deprecated: migrated to HR, kept for DB compat
  KSIEGOWOSC
  B2B
  OPLATY
  LEGALIZACJA
  TUTLO
  INNY
}

enum CaseStatus {
  NOWE                   // legacy, kept for DB compat
  OCZEKUJE_NA_DEADLINE   // legacy, kept for DB compat
  ZGLOSZONA              // v3: just reported, waiting for owner to accept
  PRZYJETA               // v3: accepted by owner, response time chosen
  KONTAKT_WSTEPNY        // first contact sent, deadline counting
  W_TOKU
  PRZEDLUZONO
  ZAMKNIETE
}

enum Salutation {
  PAN
  PANI
}

enum Language {
  PL
  EN
  RU
}

enum Gender {
  K
  M
}

enum Role {
  ADMIN
  SUPERVISOR
  EMPLOYEE
}

enum PzkPanel {
  PZK
  PZK_TUTLO
}

enum PzkClientType {
  STANDARD_KADRY
  OBCOKRAJOWIEC_HR
  OBCOKRAJOWIEC_HR_ENG
  TUTLO_PL
  TUTLO_OBCOKRAJOWIEC
}

model User {
  id             String     @id @default(uuid())
  login          String     @unique
  passwordHash   String
  fullName       String
  email          String?
  teamsUpn       String?
  dept           Department?
  role           Role       @default(EMPLOYEE)
  gender         Gender     @default(K)
  position       String?
  signatureBlock String?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())

  takenCases     Case[]     @relation("CaseTaker")
  ownedCases     Case[]     @relation("CaseOwner")
  pzkCases       PzkCase[]  @relation("PzkCreatedBy")

  @@index([login])
}

model Case {
  id                    String      @id @default(uuid())
  createdAt             DateTime    @default(now())
  channel               Channel
  taker                 String
  takerId               String?
  takerUser             User?       @relation("CaseTaker", fields: [takerId], references: [id])
  client                String
  topic                 String
  dept                  Department
  owner                 String?
  ownerId               String?
  ownerUser             User?       @relation("CaseOwner", fields: [ownerId], references: [id])
  salutation            Salutation  @default(PAN)
  language              Language    @default(PL)
  responseTime          Int?        // 1, 2, or 3 (hours)
  acceptedAt            DateTime?
  acceptedBy            String?
  deadline              DateTime?
  deadlineSetAt         DateTime?
  deadlineSetBy         String?
  status                CaseStatus  @default(ZGLOSZONA)
  extended              Boolean     @default(false)
  previousDeadline      DateTime?   // stored before extend for undo
  previousStatus        String?     // stored before status change for undo
  firstContactAt        DateTime?
  firstContactSentAt    DateTime?
  extensionSentAt       DateTime?
  closedAt              DateTime?
  note                  String?
  alert30Sent           Boolean     @default(false)
  alertOverSent         Boolean     @default(false)
  alertNoDeadlineSent   Boolean     @default(false)
  alertNoContactSent    Boolean     @default(false)
  emailNewSent          Boolean     @default(false)
  email30Sent           Boolean     @default(false)

  history               CaseHistory[]

  @@index([status])
  @@index([deadline])
  @@index([dept])
}

model CaseHistory {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  changedBy String
  changedAt DateTime @default(now())
  field     String
  oldValue  String?
  newValue  String?

  @@index([caseId])
}

model DepartmentConfig {
  id     String     @id @default(uuid())
  code   Department @unique
  name   String
  email  String?    // deprecated, kept for migration
  emails String[]   @default([])

  @@index([code])
}

model Setting {
  id                   String  @id @default("default")
  teamsWebhookUrl      String?
  workflowsWebhookUrl  String?
  bccEmail             String  @default("administracja@firmadlakazdego.pl")
  signatureTemplate    String?
  timeFormatRelative   Boolean @default(true)
}

model Worker {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─── Panel Zamknięcia Klienta ───────────────────────────────────────────────

model PzkCase {
  id                  String        @id @default(uuid())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  panel               PzkPanel

  // Module 1 – Beneficjent (key columns for listing/filtering)
  lastName            String
  firstNames          String
  benefEmail          String?
  clientType          PzkClientType
  responsibleWorker   String?       // auto from clientType, editable

  // Key date driving automations
  cooperationEndsAt   DateTime?
  withdrawnFromNotice Boolean       @default(false)  // "Rezygnacja z wypowiedzenia"
  caseClosed          Boolean       @default(false)  // "Zamknij sprawę" — blocks editing & notifications

  // Creator
  createdById         String
  createdBy           User          @relation("PzkCreatedBy", fields: [createdById], references: [id])
  createdByName       String        // snapshot for display

  // Module data (JSON blobs per spec)
  mod2Admin           Json?         // Module 2: Administration (2A, 2B, 2C)
  mod3Kadry           Json?         // Module 3: Kadry (3A, 3B)
  mod4Ksieg           Json?         // Module 4: Księgowość (4A, 4B)
  mod5Legal           Json?         // Module 5: Legalizacja (5A, 5B)
  mod6Platnosci       Json?         // Module 6: Płatności (6A, 6B)
  mod7Umowy           Json?         // Module 7: Umowy (7A B2B, 7B Najem)
  mod8Inne            Json?         // Module 8: Inne (8A Bramki, 8B Domena)

  // Manual "close" flags per module/sub-module
  mod1Closed          Boolean       @default(false)
  mod2Closed          Boolean       @default(false)
  mod2AClosed         Boolean       @default(false)
  mod2BClosed         Boolean       @default(false)
  mod2CClosed         Boolean       @default(false)
  mod3AClosed         Boolean       @default(false)
  mod3BClosed         Boolean       @default(false)
  mod4Closed          Boolean       @default(false)
  mod4AClosed         Boolean       @default(false)
  mod4BClosed         Boolean       @default(false)
  mod5Closed          Boolean       @default(false)
  mod5AClosed         Boolean       @default(false)
  mod5BClosed         Boolean       @default(false)
  mod6Closed          Boolean       @default(false)
  mod6AClosed         Boolean       @default(false)
  mod6BClosed         Boolean       @default(false)
  mod6CClosed         Boolean       @default(false)
  mod7AClosed         Boolean       @default(false)
  mod7BClosed         Boolean       @default(false)
  mod8Closed          Boolean       @default(false)
  mod8AClosed         Boolean       @default(false)
  mod8BClosed         Boolean       @default(false)

  // Notification send tracking
  emailInitialSent    Boolean       @default(false)
  emailMid15Sent      Boolean       @default(false)
  emailFinal28Sent    Boolean       @default(false)

  // Initial deadline info (set at "Wyślij sprawę")
  initialDeadline     DateTime?
  isUrgent            Boolean       @default(false)
  urgentLabel         String?       // "1h" | "2h" | "3h" | "1 dzień"

  history             PzkHistory[]

  @@index([panel])
  @@index([cooperationEndsAt])
  @@index([createdAt])
}

model PzkHistory {
  id        String   @id @default(uuid())
  caseId    String
  case      PzkCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedBy String
  changedAt DateTime @default(now())
  field     String
  oldValue  String?
  newValue  String?

  @@index([caseId])
}
