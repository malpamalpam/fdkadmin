generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Channel {
  PHONE
  EMAIL
  SMS
}

enum Department {
  KADRY
  ADMINISTRACJA
  KONTAKT
  HR
  HR_ENG // deprecated: migrated to HR, kept for DB compat
  KSIEGOWOSC
  B2B
  OPLATY
  LEGALIZACJA
  TUTLO
  INNY
}

enum CaseStatus {
  NOWE                   // legacy, kept for DB compat
  OCZEKUJE_NA_DEADLINE   // legacy, kept for DB compat
  ZGLOSZONA              // v3: just reported, waiting for owner to accept
  PRZYJETA               // v3: accepted by owner, response time chosen
  KONTAKT_WSTEPNY        // first contact sent, deadline counting
  W_TOKU
  PRZEDLUZONO
  ZAMKNIETE
}

enum Salutation {
  PAN
  PANI
}

enum Language {
  PL
  EN
  RU
}

enum Gender {
  K
  M
}

enum Role {
  ADMIN
  SUPERVISOR
  EMPLOYEE
}

model User {
  id             String     @id @default(uuid())
  login          String     @unique
  passwordHash   String
  fullName       String
  email          String?
  teamsUpn       String?
  dept           Department?
  role           Role       @default(EMPLOYEE)
  gender         Gender     @default(K)
  position       String?
  signatureBlock String?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())

  takenCases     Case[]     @relation("CaseTaker")
  ownedCases     Case[]     @relation("CaseOwner")

  @@index([login])
}

model Case {
  id                    String      @id @default(uuid())
  createdAt             DateTime    @default(now())
  channel               Channel
  taker                 String
  takerId               String?
  takerUser             User?       @relation("CaseTaker", fields: [takerId], references: [id])
  client                String
  topic                 String
  dept                  Department
  owner                 String?
  ownerId               String?
  ownerUser             User?       @relation("CaseOwner", fields: [ownerId], references: [id])
  salutation            Salutation  @default(PAN)
  language              Language    @default(PL)
  responseTime          Int?        // 1, 2, or 3 (hours)
  acceptedAt            DateTime?
  acceptedBy            String?
  deadline              DateTime?
  deadlineSetAt         DateTime?
  deadlineSetBy         String?
  status                CaseStatus  @default(ZGLOSZONA)
  extended              Boolean     @default(false)
  previousDeadline      DateTime?   // stored before extend for undo
  previousStatus        String?     // stored before status change for undo
  firstContactAt        DateTime?
  firstContactSentAt    DateTime?
  extensionSentAt       DateTime?
  closedAt              DateTime?
  note                  String?
  alert30Sent           Boolean     @default(false)
  alertOverSent         Boolean     @default(false)
  alertNoDeadlineSent   Boolean     @default(false)
  alertNoContactSent    Boolean     @default(false)
  emailNewSent          Boolean     @default(false)
  email30Sent           Boolean     @default(false)

  history               CaseHistory[]

  @@index([status])
  @@index([deadline])
  @@index([dept])
}

model CaseHistory {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  changedBy String
  changedAt DateTime @default(now())
  field     String
  oldValue  String?
  newValue  String?

  @@index([caseId])
}

model DepartmentConfig {
  id     String     @id @default(uuid())
  code   Department @unique
  name   String
  email  String?    // deprecated, kept for migration
  emails String[]   @default([])

  @@index([code])
}

model Setting {
  id                   String  @id @default("default")
  teamsWebhookUrl      String?
  workflowsWebhookUrl  String?
  bccEmail             String  @default("administracja@firmadlakazdego.pl")
  signatureTemplate    String?
  timeFormatRelative   Boolean @default(true)
}

model Worker {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
