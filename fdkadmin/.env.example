# Baza danych (Vercel Postgres lub Neon)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret do JWT (wygeneruj losowy string min. 32 znaki)
JWT_SECRET="wygeneruj-losowy-secret-min-32-znaki"

# Secret do zabezpieczenia endpointu cron (wygeneruj losowy string)
CRON_SECRET="losowy-secret-do-crona"

# Teams Incoming Webhook URL (opcjonalnie — można też ustawić w panelu)
TEAMS_WEBHOOK_URL=""

# Power Automate Workflows webhook (dla @wzmianek na Teams)
WORKFLOWS_WEBHOOK_URL=""

# Resend API Key (e-mail transakcyjny)
RESEND_API_KEY=""

# Nadawca e-maili
MAIL_FROM="rejestr@firmadlakazdego.pl"

# URL aplikacji (do linków w mailach)
NEXT_PUBLIC_APP_URL="https://fdkadmin.vercel.app"
