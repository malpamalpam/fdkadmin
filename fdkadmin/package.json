{
  "name": "fdk-admin",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate-v2": "npx tsx --env-file=.env prisma/migrate_v2.ts",
    "db:migrate-v3": "npx tsx --env-file=.env prisma/migrate_v3.ts",
    "db:migrate-v4": "npx tsx --env-file=.env prisma/migrate_v4.ts",
    "db:seed": "npx tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.9.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "resend": "^4.1.2",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "6.9.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
